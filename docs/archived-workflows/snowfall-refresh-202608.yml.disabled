name: Refresh August 2026 Native Snowfall Blend

# One-time repair of the requested retained initialization. The producer and
# publisher remain the existing reviewed workflows.
on:
  push:
    branches: [main]
    paths: [".github/workflows/snowfall-refresh-202608.yml"]
  workflow_dispatch:

permissions:
  actions: write
  contents: read

jobs:
  dispatch:
    runs-on: ubuntu-latest
    timeout-minutes: 40
    steps:
      - name: Refresh native CanSIPS map titles and download metadata
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: >-
          gh workflow run cansips.yml --ref main
          -f product=snowfall_anomaly -f init=202608
          -f lead_months=4,5 -f seasonal_window=4,5
      - name: Regenerate the native December-January snowfall blend
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: >-
          gh workflow run superensemble.yml --ref main
          -f product=snowfall_anomaly -f init=202608
          -f lead_months=4,5 -f seasonal_window=4,5
          -f minimum_members=6
      - name: Publish each successful refreshed product
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
          REFRESH_SHA: ${{ github.sha }}
        shell: bash
        run: |
          set -euo pipefail
          for workflow in cansips.yml superensemble.yml; do
            run_id=""
            for attempt in {1..12}; do
              run_id=$(gh run list --workflow "$workflow" --branch main --event workflow_dispatch --json databaseId,headSha --jq ".[] | select(.headSha == \"$REFRESH_SHA\") | .databaseId" | head -1)
              [[ -n "$run_id" ]] && break
              sleep 5
            done
            test -n "$run_id"
            gh run watch "$run_id" --exit-status --interval 15
            source_name=$(gh run view "$run_id" --json workflowName --jq .workflowName)
            gh workflow run publish-pages.yml --ref main -f source_workflow="$source_name" -f source_run_id="$run_id"
            publish_id=""
            for attempt in {1..12}; do
              publish_id=$(gh run list --workflow publish-pages.yml --branch main --event workflow_dispatch --json databaseId,headSha --jq ".[] | select(.headSha == \"$REFRESH_SHA\") | .databaseId" | head -1)
              [[ -n "$publish_id" && "$publish_id" != "${previous_publish_id:-}" ]] && break
              sleep 5
            done
            test -n "$publish_id"
            test "$publish_id" != "${previous_publish_id:-}"
            gh run watch "$publish_id" --exit-status --interval 15
            previous_publish_id="$publish_id"
          done
